# ==============================================================================
# EPAMS Repository .gitignore
# Excludes build outputs, dependencies, IDE metadata, logs, local DBs & secrets.
# Preserves source, tests, Flyway V1-V4 migrations, lockfiles, docs & .env.example.
# ==============================================================================

# Maven & Java Build Outputs
target/
**/target/
*.jar
*.war
*.ear
*.class
*.original
hs_err_pid*
replay_pid*

# Node.js / React Dependencies & Build Artifacts
node_modules/
**/node_modules/
springapp/frontend/build/
springapp/frontend/node/
springapp/backend/src/main/resources/static/
springapp/springbackend/build/
springapp/springbackend/node/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright & Test Reports / Traces
playwright-report/
**/playwright-report/
test-results/
**/test-results/
blob-report/
coverage/
**/coverage/

# IDE & Editor Metadata
.vscode/
.idea/
*.iml
*.ipr
*.iws
.settings/
.project
.classpath
.factorypath
.DS_Store
Thumbs.db

# Legacy IDE Migration Scratch Logs
.github/modernize/

# Logs, Temporary Files & Local Runtime Artifacts
*.log
*.tmp
*.temp
*.bak
*.swp
cookies.txt
uploads/
**/uploads/

# Local Embedded Database Files
*.h2.db
*.mv.db
*.trace.db
*.sqlite
*.db

# Secrets, Environment Files & Certificates (NEVER COMMIT)
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.crt
*.cer
