# ==============================================================================
# EPAMS — Safe Environment Configuration Example (.env.example)
# Copy to `.env` locally (gitignored) and supply real values via environment.
# NEVER commit real passwords, JWT secrets, API keys, or private keys to Git.
# ==============================================================================

# Active Spring Profile (omit for local H2 dev; set `mysql` for MySQL 8+)
SPRING_PROFILES_ACTIVE=mysql

# MySQL 8+ Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epams_db
DB_USERNAME=epams_app
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
FLYWAY_ENABLED=true

# JWT Signing Secret (generate >= 256-bit cryptographically random hex/base64 string)
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM_HEX_SECRET

# Cookie Security (true behind HTTPS/TLS; set false only for local HTTP staging)
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# Scheduled SLA & Auto-Closure Jobs
EPAMS_SCHEDULING_ENABLED=true

# Optional External SMTP / Mailpit Notification Delivery
EPAMS_EMAIL_ENABLED=false
EPAMS_EMAIL_HOST=127.0.0.1
EPAMS_EMAIL_PORT=1025
EPAMS_EMAIL_FROM=no-reply@epams.local
EPAMS_EMAIL_USERNAME=
EPAMS_EMAIL_PASSWORD=

# Multi-Year Corporate Holidays (comma-separated ISO YYYY-MM-DD dates)
EPAMS_HOLIDAYS=2027-01-26,2027-08-15,2027-10-02,2027-12-25
EPAMS_INCLUDE_DEFAULT_2026=true
